# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://onvite:onvite@localhost:5432/onvite?schema=public"

# Auth.js — generate a secret with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Auth.js trusts the host in local dev
AUTH_TRUST_HOST=true

# --- Redes sociales (Fase 2 · opcional) -----------------------------------
# Rellena solo las que vayas a conectar. Cómo obtener cada una:
# docs/redes-integraciones.md. Sin estas claves, "Redes" funciona en modo demo.
META_APP_ID=""            # Facebook + Instagram (Meta Graph API)
META_APP_SECRET=""
TIKTOK_CLIENT_KEY=""      # TikTok API for Business
TIKTOK_CLIENT_SECRET=""
YOUTUBE_API_KEY=""        # YouTube Data API v3 (Google Cloud)
X_BEARER_TOKEN=""         # X (Twitter) API v2
TELEGRAM_BOT_TOKEN=""     # Telegram Bot API (@BotFather)
