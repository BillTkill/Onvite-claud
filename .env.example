# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://onvite:onvite@localhost:5432/onvite?schema=public"

# Auth.js — generate a secret with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Auth.js trusts the host in local dev
AUTH_TRUST_HOST=true
